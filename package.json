{
  "name": "estanteca",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Estanteca: API AdonisJS e web Next.js",
  "license": "MIT",
  "workspaces": [
    "apps/*"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "postinstall": "node scripts/setup-env.mjs",
    "dev": "turbo dev",
    "codegen": "turbo codegen",
    "build": "turbo build",
    "test": "turbo test",
    "lint": "turbo lint",
    "format": "turbo format",
    "typecheck": "turbo typecheck"
  },
  "devDependencies": {
    "@adonisjs/prettier-config": "^1.5.0",
    "prettier": "^3.9.9",
    "turbo": "^2.11.3"
  },
  "packageManager": "npm@12.2.0",
  "allowScripts": {
    "@swc/core": true,
    "esbuild": true,
    "fsevents": true
  },
  "prettier": "@adonisjs/prettier-config"
}
